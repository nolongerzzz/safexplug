{
  "name": "safex-community-miner",
  "productName": "Safex Community Miner",
  "version": "3.3.14",
  "description": "Safex Community Miner",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/parser.test.js && node test/miner.test.js && node test/docker.test.js && node test/rigs.test.js && node test/maintenance.test.js && node test/stats.test.js && node test/wallet.test.js && node test/walletsetup.test.js && node test/hashlog.test.js && node test/rigchart.test.js && node test/updater.test.js && node test/walletapp.test.js && node test/reporter.test.js",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": {
    "name": "Safex community",
    "email": "noreply@example.invalid"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.electron.one-click-miner",
    "win": {
      "target": "nsis",
      "icon": "src/public/images/icon.png"
    },
    "mac": {
      "category": "public.app-category.business",
      "type": "distribution",
      "icon": "src/public/images/icon.png",
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "src/public/images/icon.png",
      "category": "Utility",
      "maintainer": "Safex community <noreply@example.invalid>",
      "desktop": {
        "Name": "Safex HomeBase Node+Mine",
        "Comment": "Safex Cash mining and node, with your own wallet one click away"
      }
    },
    "asar": false,
    "productName": "Safex Community Miner",
    "files": [
      "src/**/*",
      "package.json"
    ]
  },
  "homepage": "https://github.com/safex/team-1-click-miner"
}
