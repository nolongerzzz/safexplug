{
  "name": "safex-community-miner",
  "productName": "Safex Community Miner",
  "version": "2.1.0",
  "description": "Safex Community Miner",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/parser.test.js && node test/miner.test.js",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": {
    "name": "galicone"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.electron.one-click-miner",
    "win": {
      "target": "nsis",
      "icon": "src/public/images/icon.png"
    },
    "mac": {
      "category": "public.app-category.business",
      "type": "distribution",
      "icon": "src/public/images/icon.png",
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "src/public/images/icon.png",
      "category": "Utility"
    },
    "asar": false,
    "productName": "Safex Community Miner",
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}
