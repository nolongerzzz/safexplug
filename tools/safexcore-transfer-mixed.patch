+// One transaction that pays BOTH Safex Cash and Safex Tokens to the same destination(s).
+// dsts holds one entry per asset (a cash entry with amount, a token entry with token_amount; tokens whole units only).
+// Inputs are picked tokens first, then cash for the cash amount plus fee, because the ring builder lays tokens before cash.
+// Always a single transaction; throws rather than splitting.
+std::vector<wallet::pending_tx> wallet::create_transactions_mixed(std::vector<cryptonote::tx_destination_entry> dsts, const size_t fake_outs_count, const uint64_t unlock_time, uint32_t priority,
+    const std::vector<uint8_t>& extra, uint32_t subaddr_account, std::set<uint32_t> subaddr_indices, bool trusted_daemon)
+{
+  hw::device &hwdev = m_account.get_device();
+  boost::unique_lock<hw::device> hwdev_lock (hwdev);
+  hw::reset_mode rst(hwdev);
+
+  if(m_light_wallet) {
+    light_wallet_get_unspent_outs();
+  }
+
+  THROW_WALLET_EXCEPTION_IF(dsts.empty(), error::zero_destination);
+
+  uint64_t needed_cash = 0, needed_tokens = 0;
+  for (auto &dt : dsts)
+  {
+    THROW_WALLET_EXCEPTION_IF(!tools::is_whole_token_amount(dt.token_amount), error::wallet_internal_error, "Token amount must be a whole number.");
+    THROW_WALLET_EXCEPTION_IF(dt.token_transaction && dt.amount != 0, error::wallet_internal_error, "A token destination entry must not carry a cash amount.");
+    THROW_WALLET_EXCEPTION_IF(!dt.token_transaction && dt.token_amount != 0, error::wallet_internal_error, "A cash destination entry must not carry a token amount.");
+    needed_cash += dt.amount;
+    needed_tokens += dt.token_amount;
+    THROW_WALLET_EXCEPTION_IF(needed_cash < dt.amount, error::tx_sum_overflow, dsts, 0, m_nettype);
+    THROW_WALLET_EXCEPTION_IF(needed_tokens < dt.token_amount, error::tx_sum_overflow, dsts, 0, m_nettype);
+  }
+  THROW_WALLET_EXCEPTION_IF(needed_cash == 0 || needed_tokens == 0, error::wallet_internal_error, "A combined send needs both a cash amount and a token amount. Use transfer or transfer_token for one asset.");
+
+  const uint64_t fee_per_kb  = get_per_kb_fee();
+  const uint64_t fee_multiplier = get_fee_multiplier(priority, get_fee_algorithm());
+
+  // gather spendable outputs of this account (and the chosen subaddresses, if any)
+  std::vector<size_t> unused_tokens, unused_cash, unused_dust;
+  uint64_t unlocked_tokens = 0, unlocked_cash = 0;
+  for (size_t i = 0; i < m_transfers.size(); ++i)
+  {
+    const transfer_details& td = m_transfers[i];
+    if (td.m_spent || td.m_key_image_partial || td.m_subaddr_index.major != subaddr_account) continue;
+    if (!subaddr_indices.empty() && subaddr_indices.count(td.m_subaddr_index.minor) != 1) continue;
+    if (td.m_token_transfer && td.get_out_type() == tx_out_type::out_token)
+    {
+      if (!is_token_transfer_unlocked(td)) continue;
+      unused_tokens.push_back(i); unlocked_tokens += td.token_amount();
+    }
+    else if (!td.m_token_transfer && td.amount() > 0 && td.get_out_type() == tx_out_type::out_cash)
+    {
+      if (!is_transfer_unlocked(td)) continue;
+      unlocked_cash += td.amount();
+      if (td.is_rct() || is_valid_decomposed_amount(td.amount())) unused_cash.push_back(i); else unused_dust.push_back(i);
+    }
+  }
+  THROW_WALLET_EXCEPTION_IF(needed_tokens > unlocked_tokens, error::not_enough_unlocked_tokens, unlocked_tokens, needed_tokens);
+  THROW_WALLET_EXCEPTION_IF(needed_cash > unlocked_cash, error::not_enough_unlocked_cash, unlocked_cash, needed_cash, 0);
+  {
+    std::random_device rd; std::mt19937 g(rd());
+    std::shuffle(unused_tokens.begin(), unused_tokens.end(), g);
+    std::shuffle(unused_cash.begin(), unused_cash.end(), g);
+    std::shuffle(unused_dust.begin(), unused_dust.end(), g);
+  }
+
+  std::vector<size_t> selected;
+  uint64_t sel_tokens = 0, sel_cash = 0;
+  // tokens first. The ring builder and the input order both rely on tokens coming before cash.
+  while (sel_tokens < needed_tokens)
+  {
+    THROW_WALLET_EXCEPTION_IF(unused_tokens.empty(), error::not_enough_unlocked_tokens, unlocked_tokens, needed_tokens);
+    size_t idx = pop_best_value(unused_tokens, selected, true, tx_out_type::out_token);
+    selected.push_back(idx); sel_tokens += m_transfers[idx].token_amount();
+  }
+  auto add_cash = [&](uint64_t fee_now) {
+    std::vector<size_t> &src = unused_cash.empty() ? unused_dust : unused_cash;
+    THROW_WALLET_EXCEPTION_IF(src.empty(), error::tx_not_possible, unlocked_cash, needed_cash, fee_now);
+    size_t idx = pop_best_value(src, selected, false, tx_out_type::out_cash);
+    selected.push_back(idx); sel_cash += m_transfers[idx].amount();
+  };
+  const size_t n_dst = dsts.size() + 2; // + cash change + token change
+  auto estimate_fee = [&]() { return calculate_fee(fee_per_kb, estimate_tx_size(selected.size(), fake_outs_count, n_dst, extra.size()), fee_multiplier); };
+
+  uint64_t fee = estimate_fee();
+  std::vector<std::vector<tools::wallet::get_outs_entry>> outs;
+  cryptonote::transaction test_tx = AUTO_VAL_INIT(test_tx);
+  pending_tx test_ptx = AUTO_VAL_INIT(test_ptx);
+  hwdev.set_mode(hw::device::TRANSACTION_CREATE_FAKE);
+  bool built = false;
+  for (int attempt = 0; attempt < 12 && !built; ++attempt)
+  {
+    while (sel_cash < needed_cash + fee) { add_cash(fee); outs.clear(); fee = std::max(fee, estimate_fee()); }
+    transfer_selected<detail::split_strategy_function, cryptonote::tx_out_type::out_token>(dsts, selected, fake_outs_count, outs, unlock_time, fee, extra,
+        detail::digit_split_strategy, tx_dust_policy(::config::DEFAULT_DUST_THRESHOLD, ::config::DEFAULT_TOKEN_DUST_THRESHOLD), test_tx, test_ptx);
+    const auto blob = t_serializable_object_to_blob(test_ptx.tx);
+    const uint64_t real_fee = calculate_fee(fee_per_kb, blob, fee_multiplier);
+    LOG_PRINT_L2("Mixed tx " << get_size_string(blob) << ": fee paid " << print_money(test_ptx.fee) << ", needed " << print_money(real_fee));
+    if (real_fee <= test_ptx.fee) built = true; else fee = real_fee;
+  }
+  THROW_WALLET_EXCEPTION_IF(!built, error::tx_not_possible, unlocked_cash, needed_cash, fee);
+
+  hwdev.set_mode(hw::device::TRANSACTION_CREATE_REAL);
+  cryptonote::transaction final_tx = AUTO_VAL_INIT(final_tx);
+  pending_tx final_ptx = AUTO_VAL_INIT(final_ptx);
+  transfer_selected<detail::split_strategy_function, cryptonote::tx_out_type::out_token>(dsts, selected, fake_outs_count, outs, unlock_time, test_ptx.fee - (test_ptx.dust_added_to_fee ? test_ptx.dust : 0), extra,
+      detail::digit_split_strategy, tx_dust_policy(::config::DEFAULT_DUST_THRESHOLD, ::config::DEFAULT_TOKEN_DUST_THRESHOLD), final_tx, final_ptx);
+  LOG_PRINT_L1("Mixed transaction: " << print_money(needed_tokens) << " tokens + " << print_money(needed_cash) << " cash, fee " << print_money(final_ptx.fee) << ", " <<
+      selected.size() << " inputs");
+  std::vector<wallet::pending_tx> ptx_vector;
+  ptx_vector.push_back(final_ptx);
+  return ptx_vector;
+}
