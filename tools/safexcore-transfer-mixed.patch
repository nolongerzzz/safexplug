+//------------------------------------------------------------------------------------------------------------------------------
+bool wallet_rpc_server::on_transfer_mixed(
+    const wallet_rpc::COMMAND_RPC_TRANSFER_MIXED::request &req,
+    wallet_rpc::COMMAND_RPC_TRANSFER_MIXED::response &res,
+    epee::json_rpc::error &er)
+{
+    std::vector<cryptonote::tx_destination_entry> dsts;
+    std::vector<uint8_t> extra;
+
+    if (!m_wallet) return not_open(er);
+    if (m_wallet->restricted()) {
+        er.code = WALLET_RPC_ERROR_CODE_DENIED;
+        er.message = "Command unavailable in restricted mode.";
+        return false;
+    }
+
+    // the same address checks as transfer and transfer_token, once per asset
+    std::list<wallet_rpc::transfer_destination> cash_dest, token_dest;
+    cash_dest.push_back(wallet_rpc::transfer_destination()); cash_dest.back().address = req.address; cash_dest.back().amount = req.amount;
+    token_dest.push_back(wallet_rpc::transfer_destination()); token_dest.back().address = req.address; token_dest.back().amount = req.token_amount;
+    if (req.amount == 0 || req.token_amount == 0) {
+        er.code = WALLET_RPC_ERROR_CODE_ZERO_DESTINATION;
+        er.message = "transfer_mixed needs both a cash amount and a token amount; use transfer or transfer_token for one asset";
+        return false;
+    }
+    if (!tools::is_whole_token_amount(req.token_amount)) {
+        er.code = WALLET_RPC_ERROR_CODE_TX_NOT_POSSIBLE;
+        er.message = "WALLET_RPC_ERROR_CODE_TX_NOT_POSSIBLE: token amount not whole number";
+        return false;
+    }
+    if (!validate_transfer(cash_dest, req.payment_id, dsts, extra, true, er, false)) return false;
+    std::vector<uint8_t> extra_unused;
+    if (!validate_transfer(token_dest, "", dsts, extra_unused, true, er, true)) return false;
+
+    try {
+        uint64_t mixin;
+        if (req.ring_size != 0) mixin = m_wallet->adjust_mixin(req.ring_size - 1);
+        else mixin = m_wallet->adjust_mixin(req.mixin);
+        uint32_t priority = m_wallet->adjust_priority(req.priority);
+        std::vector<wallet::pending_tx> ptx_vector = m_wallet->create_transactions_mixed(
+                    dsts, mixin, req.unlock_time, priority, extra, req.account_index, req.subaddr_indices, m_trusted_daemon);
+        if (ptx_vector.size() != 1) {
+            er.code = WALLET_RPC_ERROR_CODE_TX_NOT_POSSIBLE;
+            er.message = "No transaction created";
+            return false;
+        }
+        return fill_response(ptx_vector, req.get_tx_key, res.tx_key, res.amount, res.fee, res.multisig_txset,
+                             req.do_not_relay, res.tx_hash, req.get_tx_hex, res.tx_blob, req.get_tx_metadata,
+                             res.tx_metadata, er, false);
+    }
+    catch (const std::exception &e) {
+        handle_rpc_exception(std::current_exception(), er, WALLET_RPC_ERROR_CODE_GENERIC_TRANSFER_ERROR);
+        return false;
+    }
+    return true;
+}
